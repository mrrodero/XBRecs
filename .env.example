# Copia este archivo a `.env` y ajusta los valores.
# El proyecto lee variables de entorno directamente (sin librería extra).

# --- Obligatorio en producción -------------------------------------------
# Clave secreta de Django (genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=

# URL de PostgreSQL (requiere la extensión `vector` de pgvector):
#   postgres://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xrecommender

# --- Opcional ------------------------------------------------------------
# Modo depuración (0/1). En producción debe ser 0.
DEBUG=0

# Hosts permitidos, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Hostname público del sitio (para URLs absolutas y HSTS).
RENDER_EXTERNAL_HOSTNAME=localhost:8000

# Orígenes de confianza para CSRF (https://...), separados por comas.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Si se sirve tras un proxy TLS (nginx, ALB, ...):
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# --- Explicaciones con LLM (opcional) ------------------------------------
# Proveedor compatible con la API de OpenAI.
# Sin LLM_API_KEY se usa la explicación por palabras clave.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Variables de base de datos (solo si no usas DATABASE_URL) -----------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=xrecommender
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
